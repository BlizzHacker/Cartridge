<Window x:Class="MoveWeightTvSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoveWeight TV Box 1-Click Installer"
        Height="760" Width="780"
        MinHeight="680" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#070B16">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" DockPanel.Dock="Left">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#38BDF8" Offset="0"/>
                        <GradientStop Color="#A78BFA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="▶" FontSize="22" FontWeight="Black" Foreground="#070B16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MOVEWEIGHT TV BOX 1-CLICK INSTALLER"
                           FontSize="20" FontWeight="Black" Foreground="#F8FAFC"/>
                <TextBlock Text="Turn any Onn 4K / Google TV / Android TV box into a ready-to-play Yarr.It + Retro Gaming + Media Box"
                           FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Scrollable Wizard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Step 1: Pick Android TV Box -->
                <Border Background="#111930" BorderBrush="#283B63" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Select Your Android TV / Onn 4K Box" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="On your TV: Settings → System → About → Android TV OS build (click OK 7 times) → Developer options → USB debugging ON."
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeviceCombo" Grid.Column="0" IsEditable="True"
                                      FontSize="13.5" Padding="8,6" Margin="0,0,10,0"
                                      Text="192.168.0.198"/>
                            <Button x:Name="ScanButton" Grid.Column="1" Content="Scan Wi-Fi"
                                    Click="ScanButton_Click" Padding="16,8" FontWeight="Bold"
                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                                    Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 2: Top 10 Streaming Apps to Keep -->
                <Border Background="#111930" BorderBrush="#283B63" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Streaming Apps to Keep (Everything Else Is Debloated)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Yarr.It TV, Cartridge, Argosy Launcher, Lemuroid (Zero-Core), RetroArch (4P Xbox + Netplay) are always installed."
                                   FontSize="11.5" Foreground="#4ADE80" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <CheckBox x:Name="ChkPlex" Content="Plex" IsChecked="True"/>
                            <CheckBox x:Name="ChkJellyfin" Content="Jellyfin" IsChecked="True"/>
                            <CheckBox x:Name="ChkYouTube" Content="YouTube" IsChecked="True"/>
                            <CheckBox x:Name="ChkNetflix" Content="Netflix" IsChecked="False"/>
                            <CheckBox x:Name="ChkAmazon" Content="Prime Video" IsChecked="False"/>
                            <CheckBox x:Name="ChkParamount" Content="Paramount+" IsChecked="False"/>
                            <CheckBox x:Name="ChkDisney" Content="Disney+" IsChecked="False"/>
                            <CheckBox x:Name="ChkHulu" Content="Hulu" IsChecked="False"/>
                            <CheckBox x:Name="ChkMax" Content="Max" IsChecked="False"/>
                            <CheckBox x:Name="ChkAppleTv" Content="Apple TV" IsChecked="False"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Step 3: RomM / ROMarr Library Login -->
                <Border Background="#111930" BorderBrush="#283B63" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="3. Connect Your RomM / ROMarr Game Library (Optional)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Type your login once here so you never have to type passwords with a TV remote!"
                                   FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RomM Remote URL" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="RommRemoteBox" Text="https://romm.moveweight.com"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RomM Local LAN IP (Home Fast Mode)" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="RommLocalBox" Text="http://192.168.0.94:8080"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RomM Username" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="RommUserBox" Text=""/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RomM Password" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="RommPassBox"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progress & Live Log -->
                <Border Background="#0A1124" BorderBrush="#283B63" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="StatusLabel" Text="Ready. Click 'SET UP MY TV BOX' to begin."
                                       FontSize="13" FontWeight="SemiBold" Foreground="#4ADE80"/>
                            <TextBlock x:Name="PercentLabel" Text="0%" DockPanel.Dock="Right"
                                       FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </DockPanel>
                        <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100" Value="0"
                                     Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,10"/>
                        <TextBox x:Name="LogBox" Height="130" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"
                                 Background="#060913" Foreground="#CBD5E1" BorderBrush="#1E293B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Button -->
        <Button x:Name="StartButton" Grid.Row="2" Height="52" Margin="0,14,0,0"
                Content="SET UP MY TV BOX (1-CLICK)"
                FontSize="16" FontWeight="Black"
                Background="#38BDF8" Foreground="#070B16"
                BorderThickness="0" Cursor="Hand"
                Click="StartButton_Click"/>
    </Grid>
</Window>
